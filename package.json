{
  "name": "pi-overview",
  "version": "0.1.0",
  "description": "One terminal screen for Pi usage history, cache statistics, and live subscription quotas.",
  "license": "MIT",
  "author": "timm-u and Micha\u0142 Trojnara",
  "authors": [
    {
      "name": "timm-u",
      "url": "https://github.com/timm-u"
    },
    {
      "name": "Micha\u0142 Trojnara",
      "url": "https://github.com/mtrojnar"
    }
  ],
  "type": "module",
  "main": "./overview.ts",
  "exports": {
    ".": "./overview.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "overview.ts",
    "overview-panel.ts",
    "index.ts",
    "src",
    "history",
    "README.md",
    "QUOTA-UPSTREAM.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "usage",
    "rate-limits",
    "codex",
    "anthropic",
    "claude",
    "copilot",
    "github-copilot",
    "opencode",
    "opencode-go",
    "opencode-zen",
    "openrouter",
    "spending",
    "credits",
    "kimi",
    "zai",
    "xiaomi",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/delirious6423/pi-overview.git"
  },
  "homepage": "https://github.com/delirious6423/pi-overview",
  "bugs": {
    "url": "https://github.com/delirious6423/pi-overview/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./overview.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=dot *.test.ts",
    "prepublishOnly": "npm run check && npm test",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.85.0 <1",
    "@earendil-works/pi-tui": ">=0.99.1 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-server": "0.99.1",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "@earendil-works/pi-tui": "0.99.1"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild@0.28.2": true,
    "protobufjs": false
  }
}
